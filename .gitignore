.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
*.ppk
id_rsa
id_ed25519
.aws/
credentials
*_credentials
*.kubeconfig

### Terraform ###
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.json
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
.terraform.lock.hcl.bak

# Variable files hold account IDs, CIDRs and key names. Examples are tracked, real ones are not.
*.tfvars
*.tfvars.json
!*.tfvars.example

