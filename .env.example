# TaskFlow environment variables.
#
# Copy to .env for local use:  cp .env.example .env
# .env is gitignored. Never put a real credential in this example file.
#
# In AWS none of this comes from a file: Terraform sets the plain values as `environment` entries on
# the ECS task definition, and DB_USERNAME / DB_PASSWORD are pulled from Secrets Manager through the
# task definition's `secrets` block so they never appear in the task definition JSON, in CloudWatch,
# or in `docker inspect`.

# --- Database -----------------------------------------------------------------------------------
DB_HOST=localhost
# 5433, not 5432. A natively installed PostgreSQL service will happily win the bind on localhost:5432
# over Docker's port forward, and the symptom is a baffling "password authentication failed" from a
# database you did not think you were talking to. The local container / Compose stack publishes 5433
# to sidestep it. In AWS this is 5432, the RDS endpoint port.
#
# docker compose: host mapping is DB_HOST_PORT (default 5433) -> container 5432; the app service
# itself uses DB_HOST=db and DB_PORT=5432 on the Compose network (set in docker-compose.yml).
DB_PORT=5433
DB_HOST_PORT=5433
DB_NAME=taskflow
DB_USERNAME=taskflow
# Local-only password. In AWS this comes from Secrets Manager.
DB_PASSWORD=taskflow_local
# `prefer` locally (the dev container has no TLS); Terraform sets `require` against RDS.
DB_SSL_MODE=prefer

# --- Connection pool ----------------------------------------------------------------------------
# Keep DB_POOL_MAX_SIZE * (number of running tasks) below the RDS max_connections for the
# instance class, or a scale-out event will exhaust the database's connection slots.
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_POOL_CONNECTION_TIMEOUT_MS=10000

# --- HTTP ---------------------------------------------------------------------------------------
SERVER_PORT=8080
# Must stay below the ECS task definition's stopTimeout so draining can finish before SIGKILL.
SHUTDOWN_TIMEOUT=25s

# --- Observability ------------------------------------------------------------------------------
LOG_LEVEL=INFO
APP_LOG_LEVEL=DEBUG
APP_ENVIRONMENT=local
# Health detail stays hidden in AWS; the ALB health check path is reachable from the listener.
HEALTH_SHOW_DETAILS=never
HEALTH_SHOW_COMPONENTS=never
